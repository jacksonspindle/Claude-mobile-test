# NYC Free Music Events Finder - API Keys

# SeatGeek API (Optional - for real event data)
# Get a free client ID at: https://seatgeek.com/account/develop
# Sign up, create an app, and copy your client_id
SEATGEEK_CLIENT_ID=your_seatgeek_client_id_here

# Eventbrite API (Optional - for additional event data)
# Get a free API key at: https://www.eventbrite.com/platform/api
# Create an app and generate a private token
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# Note: The app works without these keys using curated mock data
# with real NYC venue information and websites
